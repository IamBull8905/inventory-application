<div class="view-category-container">
  <div class="category-contents">
    <h1 class="category-name"><%=categoryName %></h1>
    <p class="category-description"><%=categoryDescription %></p>
  </div>
  <div class="category-buttons">
    <form action="/category/edit/<%=categoryId %>" method="GET">
      <button class="edit-category-button" type="submit">Edit</button>
    </form>
    <form action="/category/delete/<%=categoryId %>" method="POST">
      <input type="password" name="password" id="password" hidden />
      <button class="delete-category-button" id="submit-btn" type="submit">Delete</button>
    </form>
  </div>
  <script>
    const button = document.getElementById("submit-btn");
    const passwordInput = document.getElementById("password");
    button.addEventListener("click", (e) => {
      let userPassword = prompt(
        "You must enter a secret password in order to delete categories/products! ",
      );
      passwordInput.value = userPassword;
    });
  </script>
</div>
