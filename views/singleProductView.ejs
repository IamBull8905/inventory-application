<div class="view-product-container">
  <div class="product-contents">
    <div class="product-header">
      <h3><%=productName %></h3>
      <p>¥<%=productPrice %></p>
    </div>
    <div class="product-main">
      <p class="product-brand"><%=productBrand %></p>
      <p class="product-category"><%=productCategory %></p>
      <p class="product-stock"><%=productStock %> left in stock</p>
    </div>
    <p class="product-description"><%=productDescription %></p>
  </div>
  <div class="product-buttons">
    <form action="/product/edit/<%=productId %>" method="GET">
      <button class="edit-product-button" type="submit">Edit</button>
    </form>
    <form action="/product/delete/<%=productId %>" method="POST">
      <input type="password" name="password" id="password" hidden>
      <button class="delete-product-button" id="submit-btn" type="submit">Delete</button>
    </form>
  </div>
    <script>
    const button = document.getElementById("submit-btn");
    const passwordInput = document.getElementById("password");
    button.addEventListener("click", (e) => {
      let userPassword = prompt(
        "You must enter a secret password in order to delete categories/products! ",
      );
      passwordInput.value = userPassword;
    });
  </script>
</div>
